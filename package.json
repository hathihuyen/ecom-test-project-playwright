{
    "name": "ecom-test-project-playwright",
    "version": "1.0.0",
    "description": "Playwright + TypeScript E2E framework for the Practice Software Testing Toolshop",
    "scripts": {
        "test": "playwright test",
        "test:smoke": "playwright test --grep @smoke",
        "test:regression": "playwright test --grep @regression",
        "test:stress": "STRESS=1 playwright test --project=stress",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "report": "playwright show-report",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "toolshop:up": "docker compose -f docker/toolshop-compose.yml up -d --build",
        "toolshop:seed": "docker compose -f docker/toolshop-compose.yml exec -T laravel-api php artisan migrate:fresh --seed --force",
        "toolshop:down": "docker compose -f docker/toolshop-compose.yml down -v"
    },
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.4.0",
        "@playwright/test": "^1.59.1",
        "@types/node": "^25.6.0",
        "dotenv": "^17.4.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.12.1",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0"
    },
    "private": true,
    "engines": {
        "node": ">=20"
    }
}
